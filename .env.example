# Required for Supabase auth/data in browser bundles
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Required for Supabase auth/data on Vercel server functions
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix this with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: public Razorpay checkout key
VITE_RAZORPAY_KEY_ID=

# Optional: server-side payment providers
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_LIVE_API_KEY=
STRIPE_SANDBOX_API_KEY=
PAYMENTS_LIVE_WEBHOOK_SECRET=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=

# Optional: server-side Telnyx calling/SMS
TELNYX_API_KEY=
TELNYX_WEBRTC_USERNAME=
TELNYX_WEBRTC_PASSWORD=
TELNYX_PUBLIC_CALLER_ID=
TELNYX_DEFAULT_CALLER_ID=
PUBLIC_CALLER_ID=

# Optional: server-side contact/support email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPPORT_EMAIL=

# Optional: Lovable email infrastructure
LOVABLE_API_KEY=
LOVABLE_SEND_URL=
